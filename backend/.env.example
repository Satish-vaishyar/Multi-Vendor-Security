# Copy to .env and fill in. Never commit .env. The frontend never reads this file.
# Check production readiness with:  python -m app.cli check-config

# ---- deployment ----------------------------------------------------------
# development | production.  Production refuses to start on any unsafe setting below.
ENV=development
# Explicit origins/hosts in production (no "*"):  https://app.example.com
CORS_ORIGINS=*
TRUSTED_HOSTS=*
# Interactive API docs (/docs, /redoc, /openapi.json) + legacy /ui. Off in production by default.
ENABLE_DOCS=true

# ---- authentication ------------------------------------------------------
# SECURE BY DEFAULT. Setting this to false is a local-development convenience only
# (every request then acts as a dev admin) and is rejected when ENV=production.
REQUIRE_AUTH=true
# >= 32 random characters:   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# Short-lived tokens; logout and password changes revoke them server-side.
JWT_EXPIRE_MINUTES=60
# First-run bootstrap admin (created only when the users table is empty).
# Production requires a strong password (>=12 chars, mixed) - the default is rejected.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_IP_MAX_PER_MINUTE=20
PASSWORD_MIN_LENGTH=12

# ---- encryption at rest --------------------------------------------------
# Device configs are encrypted in the app BEFORE they reach the database (so Supabase/any DB
# host never sees plaintext). Comma-separated Fernet keys, newest first (rotation: prepend).
# Generate:  python -m app.cli gen-key        REQUIRED in production. Back it up separately
# from the database - losing it makes stored configs unrecoverable.
DATA_ENCRYPTION_KEYS=

# ---- AI / LLM ------------------------------------------------------------
# Customer configs NEVER leave your network unless you opt in here.
#   Option A (recommended for regulated customers): a local OpenAI-compatible model,
#            e.g. Ollama/vLLM -> FEATHERLESS_BASE_URL=http://localhost:11434/v1 (no key, no opt-in needed)
#   Option B: external API -> needs BOTH an API key and ALLOW_EXTERNAL_LLM=true.
# Secrets in config text are redacted before any call either way.
ALLOW_EXTERNAL_LLM=false
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
OKF_MODEL=openai/gpt-oss-120b

# ---- ML artifact integrity -----------------------------------------------
# strict (default in production) refuses unsigned/modified .pkl models; warn logs only.
ARTIFACT_VERIFY=
# Optional: authenticates the artifact manifest (set the same value when signing and running).
ARTIFACT_SIGNING_KEY=

# ---- CVE / NVD -----------------------------------------------------------
NVD_API_KEY=

# ---- background jobs (Postgres queue; no Redis needed) ---------------------------
# Production: run dedicated workers (docker compose up --scale worker=3, or python -m app.worker) and keep
# the API process free of audit work. Development / single-container installs may embed one worker thread.
EMBEDDED_WORKER=
WORKER_POLL_SECONDS=2
JOB_MAX_ATTEMPTS=3
# a RUNNING job with no heartbeat for this long is re-queued (its worker died)
JOB_STALE_SECONDS=900
JOB_RETENTION_DAYS=30
MAX_BATCH_FILES=500
# recurring audits + audit history
SCHEDULE_MIN_MINUTES=15
MAX_SCHEDULES_PER_ORG=1000
SNAPSHOT_RETENTION_DAYS=365
MAX_QUEUED_JOBS_PER_ORG=5000

# ---- outbound webhooks ---------------------------------------------------------
# Destinations on loopback / link-local / cloud-metadata addresses are ALWAYS refused (SSRF guard).
# Internal (RFC1918) destinations such as an on-prem SIEM need an explicit opt-in:
WEBHOOK_ALLOW_PRIVATE=false
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_TIMEOUT_S=10
WEBHOOK_MAX_PER_ORG=50
WEBHOOK_DISABLE_AFTER=20

# ---- limits & paths ------------------------------------------------------
MAX_BULK_FILES=20
OKF_DIR=../okf
MODELS_DIR=../models
HOST=127.0.0.1
PORT=8000

# ---- database ------------------------------------------------------------
# Supabase Postgres (URL-encode '@' in the password as %40). Apply schema/migrations with:
#   python -m app.cli migrate
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# ---- data retention (python -m app.cli retention [--dry-run]); 0 disables a rule ----
RETENTION_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=400
REPORT_PDF_RETENTION_DAYS=365
WEBHOOK_DELIVERY_RETENTION_DAYS=30
CONFIG_RETENTION_DAYS=0

# ---- observability ----
# GET /metrics needs "Authorization: Bearer <METRICS_TOKEN>"; REQUIRED (>=16 chars) in production
METRICS_TOKEN=
# text | json (JSON lines with request_id/org_id; secrets redacted)
LOG_FORMAT=text

# ---- abuse limits (docs/SECURITY_REVIEW.md) ----
# Request bodies are capped while they stream in: JSON/other bodies, and multipart uploads (configs), in bytes.
MAX_JSON_BODY_BYTES=8388608
MAX_UPLOAD_BODY_BYTES=115343360
# A device configuration may have at most this many lines (parse cost grows with the line count).
MAX_CONFIG_LINES=100000
# Token bucket per organisation AND per user for the expensive endpoints (audit, report, upload, AI suggest, CVE sync).
# Per API process (x workers). 0 disables the limiter; production start-up warns when it is off.
RATE_LIMIT_EXPENSIVE_PER_MIN=120
RATE_LIMIT_EXPENSIVE_BURST=30

# ---- key management (docs/SECURITY.md section 9): env | vault | aws-kms ----
KEY_PROVIDER=env
# With vault / aws-kms: leave DATA_ENCRYPTION_KEYS empty and put the WRAPPED keys here (python -m app.cli kms-wrap).
DATA_ENCRYPTION_KEYS_WRAPPED=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TRANSIT_KEY=
VAULT_NAMESPACE=
AWS_REGION=
KMS_KEY_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---- single sign-on / OpenID Connect (docs/SECURITY.md section 8); empty OIDC_ISSUER = off ----
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# https://<api-host>/api/v1/auth/sso/callback
OIDC_REDIRECT_URI=
OIDC_PROVIDER_NAME=single sign-on
OIDC_SCOPES=openid email profile
OIDC_GROUPS_CLAIM=groups
# JSON: IdP group -> role. Users with no mapped group are refused unless OIDC_DEFAULT_ROLE is set.
OIDC_ROLE_MAP={}
OIDC_DEFAULT_ROLE=
OIDC_ORG_ID=
OIDC_ALLOWED_DOMAINS=
OIDC_AUTO_PROVISION=true
OIDC_LINK_EXISTING_USERS=false
OIDC_FRONTEND_URL=http://localhost:5173
# true = password login refused for everyone except ADMIN (break-glass)
SSO_ONLY=false

# ---- row-level security (docs/SECURITY.md section 10): only after `python -m app.cli rls-enable` and a non-bypass DB role ----
RLS_ENABLED=false

# ---- live collection over SSH (docs/COLLECTION.md) ----
COLLECT_ALLOW_PRIVATE=true
# Strongly recommended in production: confine collection to your management network, e.g. 10.20.0.0/16
COLLECT_ALLOWED_CIDRS=
COLLECT_TIMEOUT_S=30
COLLECT_MAX_BYTES=8388608
