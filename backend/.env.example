# Copy to .env and fill in. Frontend never reads this — only the backend does.
# Deployment environment: development | production
ENV=development
# In production, CORS must list your frontend origin(s) explicitly.
CORS_ORIGINS=*
TRUSTED_HOSTS=*
# Enforce JWT on all /api/v1 routes except login (set true in production).
REQUIRE_AUTH=false
MAX_BULK_FILES=20
# JWT / auth (production REQUIRES a strong JWT_SECRET — dev default is rejected)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# LLM (Featherless gpt-oss-120b) — optional. Without a key the backend runs
# fully offline with deterministic heuristics (arch.md §7: deterministic wins).
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
OKF_MODEL=openai/gpt-oss-120b
# CVE / NVD (optional key raises rate limits; works without)
NVD_API_KEY=
# Paths to sibling folders (defaults work for F:\Multi-vendor layout)
OKF_DIR=../okf
MODELS_DIR=../models
# Server
HOST=127.0.0.1
PORT=8000
# Supabase Postgres (cloud DB). URL-encode '@' in password as %40.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require
