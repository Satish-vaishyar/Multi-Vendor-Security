# ============================================================
# Orbit - Multi-Vendor Security — root .gitignore
# Protects secrets (.env), local tooling, build outputs, ML artifacts
# ============================================================

# ---------- Secrets / environment ----------
# Never commit real credentials. Only *.example files are tracked.
.env
.env.*
!.env.example
!.env.development
!.env.production
backend/.env
backend/.env.*
!backend/.env.example
okf/.env
okf/.env.*
!okf/.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json

# ---------- Local agent / IDE session transcripts ----------
# Exported chat/session logs are working notes, never project documentation.
session-*.md
.opencode/

# ---------- Imported (possibly licensed) control catalogues ----------
okf/knowledge/controls/imported_*.yaml

# ---------- Python / backend ----------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
pip-wheel-metadata/
*.egg-info/
.eggs/
uv.lock.bak
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ---------- Node / frontend ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/build/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.vite/
frontend/coverage/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS / editors ----------
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# ---------- Docker / local data ----------
*.sqlite
*.sqlite3
*.db
postgres-data/
pgdata/
docker-compose.override.yml
.pytest_cache/
.cache/

# ---------- ML / caches (trained artifacts ARE tracked — app needs them) ----------
.huggingface/
torch_cache/
transformers_cache/
# Vendored MiniLM snapshot (~90 MB): downloaded once at setup via
# models/scripts/download_minilm.py, never committed.
models/artifacts/minilm/
models/.hf_cache/

# ---------- Reports / generated (sample PDFs ignored; docs kept) ----------
reports/out/
backend/reports/out/
test-results/
playwright-report/

# ---------- Misc ----------
*.tmp
*.bak
*.orig
*.swp
* - Copy.*
*~
*.pid
dist/
build/
